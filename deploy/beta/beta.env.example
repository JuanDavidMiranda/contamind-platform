# Copia este archivo como beta.env y completa los valores vacíos antes de iniciar.
# beta.env está ignorado por Git y no debe compartirse por chat, correo o commits.

# PostgreSQL interno de Docker. La base no se expone al host.
POSTGRES_USER=contamind_beta
POSTGRES_PASSWORD=
POSTGRES_DB=contamind_beta
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Puertos publicados únicamente en 127.0.0.1.
BETA_API_PORT=8000
BETA_FRONTEND_PORT=3000
# Esta URL queda compilada en el navegador; no es un secreto.
BETA_API_BASE_URL=http://localhost:8000/api/v1

# Configuración local de la beta. Para una beta externa se requiere staging,
# HTTPS y los controles adicionales descritos en README.md.
APP_NAME=ContaMind AI - beta local
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Genera secretos distintos antes de arrancar. El Compose rechaza valores vacíos.
AUTH_SECRET_KEY=
PROVIDER_CREDENTIALS_MASTER_KEY=
AUTH_TOKEN_TTL_MINUTES=480
PLATFORM_ADMIN_EMAILS=

# Mantener todas las integraciones reales y los mocks desactivados para la beta.
FEATURE_FLAGS={"DIAN_INTEGRATION_ENABLED":false,"DIAN_ELECTRONIC_HABILITATION_ENABLED":false,"SIIGO_INTEGRATION_ENABLED":false,"ALEGRA_INTEGRATION_ENABLED":false,"WORLDOFFICE_INTEGRATION_ENABLED":false,"NOVASOFT_INTEGRATION_ENABLED":false,"SYSCAFE_INTEGRATION_ENABLED":false,"LLM_ENABLED":false,"MOCK_EXTERNAL_SERVICES":false}
DIAN_ACQUIRER_URL=
OPENAI_API_KEY=
