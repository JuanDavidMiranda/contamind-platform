# Copiar este archivo a .env y ajustar los valores según el ambiente.
# NUNCA commitear el archivo .env.

# Identidad de la aplicación
APP_NAME=ContaMind AI
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Base de datos
# development/test recomendado: PostgreSQL en contenedor (puerto 5433 para
# evitar conflicto con instalaciones locales de PostgreSQL en 5432)
#   postgresql+psycopg2://contamind:contamind@localhost:5433/contamind
# pruebas rápidas aisladas: SQLite
DATABASE_URL=postgresql+psycopg2://contamind:contamind@localhost:5433/contamind

# Seguridad
# Obligatoria en staging y production. En development se genera una
# clave temporal automáticamente si no se define.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=480

# Administradores de plataforma (emails separados por coma)
PLATFORM_ADMIN_EMAILS=

# Feature flags (integración externa aún NO implementada en Fase 0)
# DIAN_INTEGRATION_ENABLED=false
# SIIGO_INTEGRATION_ENABLED=false
# LLM_ENABLED=false
# MOCK_EXTERNAL_SERVICES=true
