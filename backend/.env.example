# Copiar este archivo a .env y ajustar los valores según el ambiente.
# NUNCA commitear el archivo .env.

# Identidad de la aplicación
APP_NAME=ContaMind AI
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Base de datos
# development/test recomendado: PostgreSQL en contenedor (puerto 5433 para
# evitar conflicto con instalaciones locales de PostgreSQL en 5432)
#   postgresql+psycopg2://contamind:contamind@localhost:5433/contamind
# pruebas rápidas aisladas: SQLite
DATABASE_URL=postgresql+psycopg2://contamind:contamind@localhost:5433/contamind

# Seguridad
# Obligatoria en staging y production. En development se genera una
# clave temporal automáticamente si no se define.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=480
# Clave Fernet (base64 urlsafe) para cifrar credenciales de cada fuente.
# Obligatoria en staging y producción. Generar una con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIALS_MASTER_KEY=

# Administradores de plataforma (emails separados por coma)
PLATFORM_ADMIN_EMAILS=

# Feature flags. Se configuran como un único objeto JSON; las variables
# individuales SIIGO_INTEGRATION_ENABLED, etc. no son leídas por Settings.
# Siigo dispone de un adaptador inicial, pero debe permanecer deshabilitado hasta
# contar con credenciales autorizadas. Su contrato se prueba localmente mediante
# httpx.MockTransport; MOCK_EXTERNAL_SERVICES no redirige llamadas reales a Siigo.
FEATURE_FLAGS={"DIAN_INTEGRATION_ENABLED":false,"SIIGO_INTEGRATION_ENABLED":false,"ALEGRA_INTEGRATION_ENABLED":false,"WORLDOFFICE_INTEGRATION_ENABLED":false,"NOVASOFT_INTEGRATION_ENABLED":false,"SYSCAFE_INTEGRATION_ENABLED":false,"LLM_ENABLED":false,"MOCK_EXTERNAL_SERVICES":true}

# Sesiones de chat (persistencia temporal en memoria durante Fase 0)
SESSION_MAX_ACTIVE=1000
SESSION_TTL_SECONDS=3600

# Importación de datos
MAX_IMPORT_FILE_BYTES=5000000

# Worker de sincronización externa (cola persistente en la base de datos)
PROVIDER_SYNC_MAX_ATTEMPTS=3
PROVIDER_SYNC_RETRY_BASE_SECONDS=30
PROVIDER_SYNC_RETRY_MAX_SECONDS=3600
# Debe superar el timeout máximo de los proveedores para evitar reclamaciones duplicadas.
PROVIDER_SYNC_LEASE_SECONDS=600
PROVIDER_SYNC_WORKER_BATCH_SIZE=10
PROVIDER_SYNC_WORKER_POLL_SECONDS=5
